# Copy to .env.local and fill in. See RUNBOOK.md for where each value comes from.

# Neon Postgres — pooled endpoint (host contains "-pooler") for app runtime.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon Postgres — direct endpoint (no "-pooler") for `prisma migrate`.
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# GitHub App — Settings > Developer settings > GitHub Apps
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# Session cookie signing — 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=""



# Encrypts stored AWS secret keys: 64 hex characters (32 bytes), e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=""

# Public app URL (your tunnel URL in dev) and the GitHub App's slug
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GITHUB_APP_SLUG="ecdat-atlas"
# Vercel only: secures /api/jobs/run, the cron safety net that runs any queued scans.
# Any long random string, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=""
